# Copy to .env next to compose.yaml (keep it private) and set the passwords.
POSTGRES_PASSWORD=change-me
VALKEY_PASSWORD=change-me
# Optional:
# ECHOPHASE_VERSION=0.4.0          # server and webapp image tag
# WEBAPP_PORT=8080
# WEBAPP_BIND=127.0.0.1            # 0.0.0.0 to serve the LAN
# SCYLLA_MEMORY=1G

# Object storage (S3), off by default. SeaweedFS next to the server:
# COMPOSE_PROFILES=s3
# S3_ENDPOINT=http://s3:8333
# S3_ACCESS_KEY_ID=change-me
# S3_SECRET_ACCESS_KEY=change-me
# Or an external S3 (no profile; create its bucket yourself):
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=echophase
# S3_FORCE_PATH_STYLE=false       # true for most self-hosted S3 servers
